{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "personal-website",
	"compatibility_date": "2025-06-06",
	"main": "src/index.js",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/blog", "/blog/*", "/sitemap.xml", "/feed.xml"]
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "sapir.io",
			"custom_domain": true
		},
		{
			"pattern": "www.sapir.io",
			"custom_domain": true
		}
	]
}
